# All you need to do is place an `.editorconfig` file in the root directory containing the files whose code style you want to define.

# Everything not overridden in other sections
[*]
charset = utf-8
indent_size = 4
indent_style = space
tab_width = 4
ij_continuation_indent_size = 4
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 150

[{*.yml, *.yaml, *.properties}]
indent_size = 2
tab_width = 2

[*.md]
trim_trailing_whitespace = false

[*.tf]
indent_size = 2
tab_width = 2

[*.json]
tab_width = 2
indent_size = 2

[*.feature]
tab_width = 2
indent_size = 2
